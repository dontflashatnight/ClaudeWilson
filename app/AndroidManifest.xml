<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.walter.claudewilson"
    android:versionCode="8"
    android:versionName="0.6.0">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- read-only network state: default proxy, VPN transport, active network.
         Without it ConnectivityManager throws and the proxy/VPN checks can only say
         "unobserved"; it grants no network access (INTERNET is still absent). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- self-diagnostic tool, sideloaded: full package census for denylist-superset view.
         Note: Play policy would gate this; this app is not distributed via Play. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- dual-SIM enumeration (SubscriptionManager list); degrades gracefully if denied -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Play country probe via BillingClient.getBillingConfig -->
    <uses-permission android:name="com.android.vending.BILLING" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <queries>
        <package android:name="com.anthropic.claude"/>
        <package android:name="com.openai.chatgpt"/>
        <package android:name="com.android.vending"/>
        <package android:name="com.google.android.gms"/>
        <package android:name="eu.chainfire.supersu"/>
        <package android:name="com.koushikdutta.superuser"/>
        <package android:name="com.thirdparty.superuser"/>
        <package android:name="com.yellowes.su"/>
        <package android:name="com.noshufou.android.su"/>
        <package android:name="com.noshufou.android.su.elite"/>
        <package android:name="com.koushikdutta.rommanager"/>
        <package android:name="com.dimonvideo.luckypatcher"/>
        <package android:name="com.chelpus.lackypatch"/>
        <package android:name="com.ramdroid.appquarantine"/>
        <package android:name="com.devadvance.rootcloak"/>
        <package android:name="com.devadvance.rootcloakplus"/>
        <package android:name="com.amphoras.hidemyroot"/>
        <package android:name="com.formyhm.hideroot"/>
        <package android:name="com.zachspong.temprootremovejb"/>
        <package android:name="com.saurik.substrate"/>
        <package android:name="moe.shizuku.privileged.api"/>
        <package android:name="de.robv.android.xposed.installer"/>
        <!-- modern root/hide tooling beyond T-1's 17-name list -->
        <package android:name="me.weishu.kernelsu"/>
        <package android:name="com.topjohnwu.magisk"/>
        <package android:name="io.github.vvb2060.magisk"/>
        <package android:name="io.github.huskydg.magisk"/>
        <package android:name="org.lsposed.manager"/>
        <package android:name="io.github.lsposed.manager"/>
        <package android:name="com.tsng.hidemyapplist"/>
        <package android:name="io.github.imkamaran.hidemydevice"/>
        <package android:name="com.hidemydevice"/>
        <package android:name="com.hide.my.device"/>
        <package android:name="com.privacymask.xposed"/>
        <package android:name="local.settings.entryhider"/>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="market"/>
        </intent>
        <intent>
            <action android:name="com.android.vending.billing.InAppBillingService.BIND"/>
        </intent>
    </queries>

    <application android:allowBackup="false" android:debuggable="false"
        android:usesCleartextTraffic="false"
        android:label="ClaudeWilson" android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.android.billingclient.api.ProxyBillingActivity"
            android:configChanges="keyboard|keyboardHidden|screenLayout|screenSize|orientation"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <meta-data
            android:name="com.google.android.play.billingclient.version"
            android:value="8.0.0" />
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="com.walter.claudewilson.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:initOrder="100"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <meta-data
            android:name="moe.shizuku.client.V3_SUPPORT"
            android:value="true" />
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription"
            android:value="ClaudeWilson automatic persona module" />
        <meta-data android:name="xposedminversion" android:value="93" />
    </application>
</manifest>
